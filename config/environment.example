# Copy only the settings you need into the process environment or a local,
# Git-ignored .env file. This project does not parse .env files itself.
MARKET_DATA_ENABLED=true
MARKET_DATA_TIMEZONE=Asia/Shanghai
MARKET_DATA_CONNECT_TIMEOUT_MS=10000
MARKET_DATA_REQUEST_TIMEOUT_MS=15000
MARKET_DATA_MAX_ATTEMPTS_PER_DAY=4
MARKET_DATA_MANUAL_REFRESH_COOLDOWN_MINUTES=30
MARKET_DATA_PROVIDER_DAILY_LIMIT=20

# Runtime confirmation cannot override config/market-data-providers.json.
CBOE_DATA_LICENSE_CONFIRMED=false

# Optional future setting. Keep credentials only in the local environment.
FRED_API_KEY=
