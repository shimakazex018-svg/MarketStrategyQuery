# The application reads environment variables from the process environment.
# It does not parse .env files and has no third-party runtime dependency.
MARKET_DATA_ENABLED=true
MARKET_DATA_TIMEZONE=Asia/Shanghai
MARKET_DATA_CONNECT_TIMEOUT_MS=10000
MARKET_DATA_REQUEST_TIMEOUT_MS=15000
MARKET_DATA_MAX_ATTEMPTS_PER_DAY=4
MARKET_DATA_MANUAL_REFRESH_COOLDOWN_MINUTES=30
MARKET_DATA_PROVIDER_DAILY_LIMIT=20

# Cboe requires prior permission for storing/displaying its website content.
# Leave false unless written permission explicitly covers this application.
CBOE_DATA_LICENSE_CONFIRMED=false

# Reserved for a future approved FRED source. The application starts without it.
FRED_API_KEY=
